# Copy this file to .env and fill in your values.
# Never share your .env file or put real keys in HTML.

# Flask uses this to keep form sessions safe. Use any long random string.
FLASK_SECRET_KEY=change-me-to-a-long-random-string

# Get a free key from https://www.sarvam.ai/ (no credit card required).
SARVAM_API_KEY=your_sarvam_api_key_here

# Optional. Adding an email can raise MyMemory's daily character limit.
# Leave blank to use the anonymous free limit.
MYMEMORY_EMAIL=
