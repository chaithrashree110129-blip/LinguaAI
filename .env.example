# Copy this file to .env and fill in your values.
# Never share your .env file or put real keys in HTML.

# Flask uses this to keep form sessions safe. Use any long random string.
FLASK_SECRET_KEY=change-me-to-a-long-random-string

# Required for English and Indian-language translations. Get a key from
# https://www.sarvam.ai/ and replace this placeholder.
SARVAM_API_KEY=your_sarvam_api_key_here

# Optional contact email for MyMemory usage.
# Leave blank to use the anonymous free limit.
MYMEMORY_EMAIL=
